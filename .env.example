# 本地配置按用途分组。复制示例后填写实际值；.env 受 Git 忽略，禁止提交。
# Java 读取根目录 .env；Docker 需 --env-file .env，且只有 Compose 显式引用的变量才生效。

# ===== 运行环境 =====
# local 为本地运行配置；启用课程向量连接还需追加 vector profile（local,vector）。
SPRING_PROFILES_ACTIVE=local

# ===== MySQL 业务数据库 =====
# 保存业务数据、会话和消息历史，是业务事实源；此处为 Java 连接参数，不会修改已有 Docker 数据库账号。
LEARNHUB_DB_URL=jdbc:mysql://localhost:3306/learnhub?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
LEARNHUB_DB_USERNAME=learnhub
LEARNHUB_DB_PASSWORD=learnhub

# ===== Redis 缓存与运行保护 =====
# 用于缓存、登录状态、限流及助理共享预算等；地址应从后端进程所在环境访问。
LEARNHUB_REDIS_HOST=localhost
LEARNHUB_REDIS_PORT=6379

# ===== RabbitMQ 消息 =====
# 连接参数及消息总开关；基础 Compose 的容器账号目前单独定义，修改本文件不会自动同步账号。
LEARNHUB_RABBITMQ_HOST=localhost
LEARNHUB_RABBITMQ_PORT=5672
LEARNHUB_RABBITMQ_USERNAME=learnhub
LEARNHUB_RABBITMQ_PASSWORD=learnhub
LEARNHUB_MESSAGING_ENABLED=true

# ===== Elasticsearch 课程搜索 =====
# 课程搜索索引、中文分词及同步补偿；使用 IK 分词器前需安装对应插件。
LEARNHUB_ES_URIS=http://localhost:9200
LEARNHUB_SEARCH_ALIAS=learnhub-courses-search
LEARNHUB_SEARCH_ANALYZER=ik_max_word
LEARNHUB_SEARCH_SEARCH_ANALYZER=ik_smart
LEARNHUB_SEARCH_SYNC_ENABLED=true
LEARNHUB_SEARCH_SYNC_DELAY=5000
LEARNHUB_SEARCH_SYNC_BATCH_SIZE=100

# ===== 知识讲义 BM25 检索 =====
# 先执行知识表迁移再开启索引同步；MySQL 保存原文与权限，ES 保存可重建检索投影。
LEARNHUB_KNOWLEDGE_SYNC_ENABLED=false
LEARNHUB_KNOWLEDGE_ALIAS=learnhub-knowledge-search

# ===== 秒杀、点赞与异步补偿 =====
# 控制消息重试、异步落库、对账和旧键迁移；未显式配置的项目使用代码默认值。
LEARNHUB_SECKILL_MAX_PUBLISH_ATTEMPTS=5
LEARNHUB_SECKILL_CONSUMER_CONFIRMATION_TIMEOUT=PT1M
LEARNHUB_SECKILL_RESERVATION_ORPHAN_TIMEOUT=PT1M
LEARNHUB_SECKILL_RECONCILIATION_ENABLED=true
LEARNHUB_SECKILL_RECONCILIATION_DELAY=10000
LEARNHUB_LIKE_FLUSH_ENABLED=true
LEARNHUB_LIKE_FLUSH_DELAY=5000
LEARNHUB_LIKE_PUBLISH_RETRY_ENABLED=true
LEARNHUB_LIKE_PUBLISH_RETRY_DELAY=5000
LEARNHUB_LIKE_RECONCILIATION_ENABLED=true
LEARNHUB_LIKE_RECONCILIATION_DELAY=3600000
LEARNHUB_LIKE_LEGACY_KEY_MIGRATION_ENABLED=true
LEARNHUB_LIKE_PUBLISHER_CONFIRM_TIMEOUT=10s

# ===== 支付与订单 =====
# LOCAL_DEMO 为本地演示支付；待支付超时使用 ISO-8601 时长，例如 PT30M。
LEARNHUB_PAYMENT_MODE=LOCAL_DEMO
LEARNHUB_ORDER_PENDING_TIMEOUT=PT30M

# ===== JWT 签名密钥位置 =====
# 填写私钥和公钥的本地文件位置，不能把密钥正文写进本文件或提交仓库。
LEARNHUB_JWT_PRIVATE_KEY_PATH=
LEARNHUB_JWT_PUBLIC_KEY_PATH=

# ===== OSS 对象存储 =====
# 用于文件上传；开启时需配置区域、Endpoint、Bucket 和本地访问凭据，禁止提交或输出凭据。
LEARNHUB_OSS_ENABLED=false
LEARNHUB_OSS_REGION=cn-beijing
LEARNHUB_OSS_ENDPOINT=
LEARNHUB_OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ===== DeepSeek 模型与 HTTP 限制 =====
# 模型模式、模型名、供应商密钥及请求限制；真实调用产生费用，密钥仅保存在本地。
LEARNHUB_AI_MODE=DISABLED
LEARNHUB_DEEPSEEK_API_KEY=
LEARNHUB_AI_MODEL=deepseek-flash
LEARNHUB_AI_MAX_OUTPUT_TOKENS=1024
LEARNHUB_AI_REQUEST_TIMEOUT=PT20S
LEARNHUB_AI_CONNECT_TIMEOUT=PT5S
LEARNHUB_AI_MAX_INPUT_BYTES=131072
LEARNHUB_AI_MAX_RESPONSE_BYTES=262144
LEARNHUB_AI_TRANSPORT_THREADS=4

# ===== Mem0 学习偏好访问 =====
# 总开关默认关闭，默认地址 http://127.0.0.1:18280；服务令牌须与容器一致。自动提取默认关闭，开启后额外模型调用仍计入共享预算。
LEARNHUB_ASSISTANT_MEMORY_ENABLED=false
LEARNHUB_ASSISTANT_MEMORY_BASE_URL=http://127.0.0.1:18280
LEARNHUB_ASSISTANT_MEMORY_SERVICE_TOKEN=
LEARNHUB_ASSISTANT_MEMORY_TIMEOUT=PT2S
LEARNHUB_ASSISTANT_MEMORY_AUTO_EXTRACT_ENABLED=false

# ===== 独立学习助理、LangChain4j 与预算 =====
# 先执行会话迁移再开启聊天；LangChain4j 适配器有独立开关。预算按 UTF-8 字节保守估算，非精确 tokenizer 或人民币限额；每日按 UTC 计数，同时限制每用户及所有实例，超时不退还预留。
LEARNHUB_ASSISTANT_TIMEOUT=PT45S
LEARNHUB_ASSISTANT_MAX_MODEL_CALLS=4
LEARNHUB_ASSISTANT_MAX_TOOL_ROUNDS=3
LEARNHUB_ASSISTANT_MAX_TOOL_CALLS=4
LEARNHUB_ASSISTANT_MAX_RUN_TOKENS=24000
LEARNHUB_ASSISTANT_MAX_OUTPUT_TOKENS=1200
LEARNHUB_ASSISTANT_GLOBAL_CONCURRENCY=4
LEARNHUB_ASSISTANT_REQUESTS_PER_MINUTE=6
LEARNHUB_ASSISTANT_DAILY_MODEL_CALLS=20
LEARNHUB_ASSISTANT_DAILY_RESERVED_TOKENS=120000
LEARNHUB_ASSISTANT_MAX_INPUT_BYTES=16000
# 必须填写已核验的模型窗口 Token 数；0 表示未配置，生成请求会在预留/HTTP 前拒绝，Fake 不受影响。
# 2026-10-21 官方 /models 文档明确 deepseek-flash 与 deepseek-v4-pro 均为 1048576；换模型须重新核验。
LEARNHUB_ASSISTANT_MODEL_WINDOW_TOKENS=1048576
LEARNHUB_ASSISTANT_CONTEXT_SAFETY_MARGIN_TOKENS=256
# 运行内语义压缩默认关闭；开启仍复用原调用/Token/输入字节和时间限额。
LEARNHUB_ASSISTANT_CONTEXT_REDESIGN_ENABLED=false
LEARNHUB_ASSISTANT_CONTEXT_SOFT_PRESSURE=0.75
LEARNHUB_ASSISTANT_CONTEXT_TARGET_PRESSURE=0.55
LEARNHUB_ASSISTANT_SUMMARY_OUTPUT_TOKENS=512
LEARNHUB_ASSISTANT_TOOL_OBSERVATION_RESERVE_BYTES=1024
LEARNHUB_ASSISTANT_CONTEXT_RECOVERY_MAX_MESSAGES=400
LEARNHUB_ASSISTANT_CONTEXT_RECOVERY_MAX_BYTES=131072
LEARNHUB_ASSISTANT_CHAT_ENABLED=false
LEARNHUB_ASSISTANT_LANGCHAIN_ENABLED=false

# ===== 课程向量 PostgreSQL / pgvector =====
# 独立于 MySQL 和 Mem0 记忆库；需 vector profile、独立数据库及双方迁移。连接、同步、混合检索分别控制，默认关闭；密码须另行配置。
LEARNHUB_VECTOR_ENABLED=false
LEARNHUB_VECTOR_HYBRID_ENABLED=false
# 混合候选原始语义分数门槛（score=(1+cosine)/2），不是RRF分数；0关闭，仅本模型标定。
LEARNHUB_VECTOR_MIN_SEMANTIC_SCORE=0.815
LEARNHUB_VECTOR_SYNC_ENABLED=false
LEARNHUB_VECTOR_JDBC_URL=jdbc:postgresql://127.0.0.1:15432/learnhub_vector
LEARNHUB_VECTOR_USERNAME=learnhub_vector_app
LEARNHUB_VECTOR_PASSWORD=
# 课程向量库 Docker 初始化专用管理员密码；Java 使用上方独立 DML 账号。
LEARNHUB_VECTOR_ADMIN_PASSWORD=

# ===== Mem0 Docker 私有依赖 =====
# Compose 需要独立的 PG 管理员密码、运行账号密码、向量桥令牌，并复用上方记忆服务令牌。只对本机开放 API 端口（默认 18280），PG 不映射宿主端口。
LEARNHUB_MEMORY_PG_ADMIN_PASSWORD=
LEARNHUB_MEMORY_PG_PASSWORD=
LEARNHUB_MEMORY_EMBEDDING_TOKEN=
LEARNHUB_MEMORY_LOCAL_PORT=18280
