# 只需填写连接、凭据、运行开关和成本边界；.env 受 Git 忽略，禁止提交。
# Java 读取根目录/上级目录 .env；Docker 只读取 Compose 显式引用的变量。
# 重试、超时、线程、批量、摘要和工具大小等调优项已有代码/YAML默认值，无需逐项抄写。
# 特殊环境仍可按 application*.yml 中现有变量名显式覆盖；仅保留确有差异的项。

# ===== 环境与基础连接 =====
SPRING_PROFILES_ACTIVE=local
LEARNHUB_DB_URL=jdbc:mysql://localhost:3306/learnhub?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
LEARNHUB_DB_USERNAME=learnhub
LEARNHUB_DB_PASSWORD=learnhub
LEARNHUB_REDIS_HOST=localhost
LEARNHUB_REDIS_PORT=6379
LEARNHUB_RABBITMQ_HOST=localhost
LEARNHUB_RABBITMQ_PORT=5672
LEARNHUB_RABBITMQ_USERNAME=learnhub
LEARNHUB_RABBITMQ_PASSWORD=learnhub
LEARNHUB_ES_URIS=http://localhost:9200

# ===== 业务模式与索引同步 =====
# LOCAL_DEMO不发生真实资金交易；同步开关依据本机迁移/索引准备情况启用。
LEARNHUB_MESSAGING_ENABLED=true
LEARNHUB_PAYMENT_MODE=LOCAL_DEMO
LEARNHUB_SEARCH_SYNC_ENABLED=true
LEARNHUB_KNOWLEDGE_SYNC_ENABLED=false

# ===== JWT密钥文件与OSS =====
# 仅填写密钥文件路径，禁止放入密钥正文；容器已有账号不会因修改本文件自动变更。
LEARNHUB_JWT_PRIVATE_KEY_PATH=
LEARNHUB_JWT_PUBLIC_KEY_PATH=
LEARNHUB_OSS_ENABLED=false
LEARNHUB_OSS_REGION=cn-beijing
LEARNHUB_OSS_ENDPOINT=
LEARNHUB_OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ===== 模型身份与学习助理开关 =====
# 新环境默认禁用真实生成；窗口值须与已核验的模型规格配套，不能按模型名猜测。
LEARNHUB_AI_MODE=DISABLED
LEARNHUB_DEEPSEEK_API_KEY=
LEARNHUB_AI_MODEL=deepseek-flash
LEARNHUB_ASSISTANT_MODEL_WINDOW_TOKENS=1048576
LEARNHUB_ASSISTANT_CHAT_ENABLED=false
LEARNHUB_ASSISTANT_LANGCHAIN_ENABLED=false
# 安装对应迁移并验证后才启用新上下文路径。
LEARNHUB_ASSISTANT_CONTEXT_REDESIGN_ENABLED=false

# ===== 成本边界 =====
# 保守Token预留，非人民币额度；日限额按UTC，取消和未知usage不退款。
LEARNHUB_ASSISTANT_MAX_RUN_TOKENS=24000
LEARNHUB_ASSISTANT_DAILY_MODEL_CALLS=20
LEARNHUB_ASSISTANT_DAILY_RESERVED_TOKENS=120000

# ===== 学习偏好记忆 =====
# 自动提取独立控制，开启会额外消耗同一模型预算。
LEARNHUB_ASSISTANT_MEMORY_ENABLED=false
LEARNHUB_ASSISTANT_MEMORY_AUTO_EXTRACT_ENABLED=false
LEARNHUB_ASSISTANT_MEMORY_BASE_URL=http://127.0.0.1:18280
LEARNHUB_ASSISTANT_MEMORY_SERVICE_TOKEN=

# ===== 课程向量库 =====
# 需要vector profile、独立数据库和迁移；Java使用独立DML账号。
LEARNHUB_VECTOR_ENABLED=false
LEARNHUB_VECTOR_HYBRID_ENABLED=false
LEARNHUB_VECTOR_SYNC_ENABLED=false
LEARNHUB_VECTOR_JDBC_URL=jdbc:postgresql://127.0.0.1:15432/learnhub_vector
LEARNHUB_VECTOR_USERNAME=learnhub_vector_app
LEARNHUB_VECTOR_PASSWORD=
LEARNHUB_VECTOR_ADMIN_PASSWORD=

# ===== Mem0 Compose私有依赖 =====
# 保留Compose/验证脚本直接读取的密码、令牌和端口，不能用Java默认值替代。
LEARNHUB_MEMORY_PG_ADMIN_PASSWORD=
LEARNHUB_MEMORY_PG_PASSWORD=
LEARNHUB_MEMORY_EMBEDDING_TOKEN=
LEARNHUB_MEMORY_LOCAL_PORT=18280
